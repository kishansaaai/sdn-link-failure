{
  "__inputs": [],
  "__requires": [],
  "annotations": {
    "list": []
  },
  "description": "SDN Controller \u2014 Live topology, recovery metrics, flow stats",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Controller Role",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sdn_controller_role",
          "legendFormat": "{{instance}}"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sdn-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "BACKUP"
                },
                "1": {
                  "text": "PRIMARY"
                }
              }
            }
          ],
          "thresholds": {
            "steps": [
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Desired path rules (active controller)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "expr": "sdn_active_flows and on(instance) (sdn_controller_role == 1)",
          "legendFormat": "Flows"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sdn-prometheus"
      }
    },
    {
      "id": 3,
      "title": "Flow Installs / sec",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(sdn_flow_install_total[1m])",
          "legendFormat": "Installs/s"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "sdn-prometheus"
      }
    },
    {
      "id": 4,
      "title": "Link Health",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "sdn_link_up",
          "legendFormat": "{{src}} \u2192 {{dst}}",
          "instant": true
        }
      ],
      "options": {
        "sortBy": [
          {
            "displayName": "Value",
            "desc": false
          }
        ]
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sdn-prometheus"
      }
    },
    {
      "id": 5,
      "title": "Controller enqueue time: mean (ms)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "rate(sdn_recovery_time_ms_sum[5m]) / rate(sdn_recovery_time_ms_count[5m])",
          "legendFormat": "{{instance}} mean"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "sdn-prometheus"
      }
    },
    {
      "id": 6,
      "title": "Controller enqueue time: p50/p95 (ms)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(sdn_recovery_time_ms_bucket[5m]))",
          "legendFormat": "{{instance}} p95"
        },
        {
          "expr": "histogram_quantile(0.50, rate(sdn_recovery_time_ms_bucket[5m]))",
          "legendFormat": "{{instance}} p50"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "sdn-prometheus"
      }
    },
    {
      "id": 7,
      "title": "Unexpected OpenFlow errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sdn-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "sdn_openflow_errors_total",
          "legendFormat": "{{instance}}"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "tags": [
    "sdn",
    "openflow",
    "ryu"
  ],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "title": "SDN Controller Dashboard",
  "uid": "sdn-controller-v2",
  "version": 1
}
